<robot name="testbed">
  <link name="base_footprint"></link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.496 0.396 0.14" />
      </geometry>
      <material name="base_link-material">
        <color rgba="0.033104766565152086 0.46778379610254284 0.12477181755144427 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.496 0.396 0.14" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.16666666666666666" ixy="0" ixz="0" iyy="0.16666666666666666" iyz="0" izz="0.16666666666666666" />
    </inertial>
  </link>
  <joint name="base_link_to_wheel_back_left" type="continuous">
    <parent link="base_link" />
    <child link="wheel_back_left" />
    <origin xyz="0.19 -0.25 -0.11" rpy="1.5707963267948963 0 0" />
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_back_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.11" length="0.08" />
      </geometry>
      <material name="wheel_back_left-material">
        <color rgba="0.6375968739867731 0.04373502925049377 0.008023192982520563 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.11" length="0.08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.3333333333333333" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.3333333333333333" />
    </inertial>
  </link>
  <joint name="base_link_to_wheel_back_right" type="continuous">
    <parent link="base_link" />
    <child link="wheel_back_right" />
    <origin xyz="0.19 0.25 -0.11" rpy="1.5707963267948963 0 0" />
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_back_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.11" length="0.08" />
      </geometry>
      <material name="wheel_back_right-material">
        <color rgba="0.6375968739867731 0.04373502925049377 0.008023192982520563 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.11" length="0.08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.3333333333333333" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.3333333333333333" />
    </inertial>
  </link>
  <joint name="base_link_to_wheel_front_left" type="continuous">
    <parent link="base_link" />
    <child link="wheel_front_left" />
    <origin xyz="-0.19 -0.25 -0.11" rpy="1.5707963267948963 0 0" />
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_front_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.11" length="0.08" />
      </geometry>
      <material name="wheel_front_left-material">
        <color rgba="0.6375968739867731 0.04373502925049377 0.008023192982520563 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.11" length="0.08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.3333333333333333" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.3333333333333333" />
    </inertial>
  </link>
  <joint name="base_link_to_wheel_front_right" type="continuous">
    <parent link="base_link" />
    <child link="wheel_front_right" />
    <origin xyz="-0.19 0.25 -0.11" rpy="1.5707963267948963 0 0" />
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_front_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.11" length="0.08" />
      </geometry>
      <material name="wheel_front_right-material">
        <color rgba="0.6375968739867731 0.04373502925049377 0.008023192982520563 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.11" length="0.08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.3333333333333333" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.3333333333333333" />
    </inertial>
  </link>
  <joint name="base_link_to_camera_link" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.24 0 0.08" rpy="0 0 0" />
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.0254 0.1 0.0254" />
      </geometry>
      <material name="camera_link-material">
        <color rgba="0.8468732315065057 0.8468732315065057 0.8468732315065057 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.0254 0.1 0.0254" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.16666666666666666" ixy="0" ixz="0" iyy="0.16666666666666666" iyz="0" izz="0.16666666666666666" />
    </inertial>

        <sensor name="realsense_camera" type="camera">
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <origin>0.24 0 0.08 0 0 0</origin>
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>1920</width>
                    <height>1080</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.105</near>
                    <far>10</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.01</mean>
                </noise>
            </camera>
        </sensor>
      </link>
</robot>